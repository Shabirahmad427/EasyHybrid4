<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="dialog">
    <property name="name">dialog</property>
    <property name="focusable">False</property>
    <property name="title" translatable="yes">Position Harmonic Restraint</property>
    <child internal-child="content_area">
      <object class="GtkBox">
        <property name="focusable">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child internal-child="action_area">
          <object class="GtkBox">
            <property name="focusable">False</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="button_cancel">
                <property name="hexpand">True</property>
                <property name="label" translatable="yes">Cancel</property>
                <property name="visible">True</property>
                <property name="focusable">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_add">
                <property name="hexpand">True</property>
                <property name="label" translatable="yes">Add</property>
                <property name="visible">True</property>
                <property name="focusable">True</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>
            <property name="margin-start">10</property>
            <property name="margin-end">10</property>
            <child>
              <object class="GtkBox" id="position_restraint_box">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <child>
                  <!-- n-columns=2 n-rows=3 -->
                  <object class="GtkGrid" id="pr_grid">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">10</property>
                    <property name="column-homogeneous">False</property>
                    <child>
                      <object class="GtkLabel" id="label_atom_count">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="label" translatable="yes">Atoms selected:</property>
                        <property name="xalign">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="entry_atom_count">
                        <property name="visible">True</property>
                        <property name="focusable">True</property>
                        <property name="halign">start</property>
                        <property name="editable">False</property>
                        <property name="width-chars">8</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label_force_position">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="label" translatable="yes">Force Constant:</property>
                        <property name="xalign">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="entry_FORCE_position">
                        <property name="visible">True</property>
                        <property name="focusable">True</property>
                        <property name="halign">start</property>
                        <property name="width-chars">8</property>
                        <property name="text" translatable="yes">1000</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label_color_position">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="label" translatable="yes">Representation Color:</property>
                        <property name="xalign">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkColorButton" id="colorbutton_position">
                        <property name="visible">True</property>
                        <property name="focusable">True</property>
                        <property name="halign">start</property>
                        <property name="use-alpha">False</property>
                        <property name="title" translatable="yes">Pick the dots color</property>
                        <!-- Magenta (1,0,1) para bater com o default historico do
                             OneColorDotsRepresentation quando nenhuma cor e escolhida. -->
                        <property name="rgba">rgb(255,0,255)</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>