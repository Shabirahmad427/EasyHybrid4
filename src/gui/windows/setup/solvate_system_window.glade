<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="adjustment1">
    <property name="upper">1000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="upper">1000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkWindow" id="window">
    <property name="focusable">False</property>
    <property name="title" translatable="yes">Solvate System</property>
    <property name="default-width">460</property>
    <signal name="close-request" handler="close_window" swapped="no" />
    <child type="titlebar">
      <placeholder />
    </child>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="focusable">False</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">9</property>
            <!-- ==================== Solute ==================== -->
            <child>
              <object class="GtkFrame" id="dftp_setup_box2">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label-xalign">0.5</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="margin-top">10</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <child>
                      <object class="GtkBox" id="geo_opt_parm_box2">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">11</property>
                        <child>
                          <object class="GtkGrid">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">10</property>
                            <child>
                              <object class="GtkBox" id="box_system">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="hexpand">True</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="box_coordinates">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="hexpand">True</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_system5">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">System:</property>
                                <property name="xalign">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_system6">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Object / frame:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Which loaded structure/frame of this system to solvate. Useful when a system has several loaded coordinate sets (e.g. different frames of a trajectory).</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="checkbox_reorient">
                            <property name="label" translatable="yes">Reorient solute along principal axes</property>
                            <property name="visible">True</property>
                            <property name="focusable">True</property>
                            <property name="tooltip-text" translatable="yes">Rotates the solute onto its principal axes before adding ions/solvent, which usually gives a tighter, more symmetric box.</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="label" translatable="yes">Solute</property>
                  </object>
                </child>
              </object>
            </child>
            <!-- ==================== Solvent Box ==================== -->
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="margin-top">5</property>
                <property name="margin-bottom">5</property>
                <property name="margin-start">5</property>
                <property name="margin-end">5</property>
                <child>
                  <object class="GtkFrame" id="dftp_setup_box3">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="label-xalign">0.5</property>
                    <child>
                      <object class="GtkBox" id="frame_solvent_box">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-start">10</property>
                        <property name="margin-end">10</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <child>
                              <!-- n-columns=2 n-rows=1 -->
                              <object class="GtkGrid">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">Pre-built solvent box:</property>
                                    <property name="xalign">1</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="box_solvent_box2">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="hexpand">True</property>
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <placeholder />
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="button_make_solvent_box">
                                    <property name="label" translatable="yes">Make Solvent Box...</property>
                                    <property name="visible">True</property>
                                    <property name="focusable">True</property>
                                    <property name="tooltip-text" translatable="yes">Opens the "Make Solvent Box" tool to build a new pre-equilibrated solvent box (e.g. water) that can then be selected here.</property>
                                    <signal name="clicked" handler="on_button_make_solvent_box_clicked" swapped="no" />
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Ion-placement box (Å) -- auto-filled from the solvent box above, editable if needed:</property>
                                <property name="wrap">True</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="dim-label" />
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkGrid">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="row-spacing">1</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">X:</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">Y:</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">Z:</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry_a">
                                    <property name="visible">True</property>
                                    <property name="focusable">True</property>
                                    <property name="text">30.0</property>
                                    <property name="width-chars">7</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry_b">
                                    <property name="visible">True</property>
                                    <property name="focusable">True</property>
                                    <property name="text">30.0</property>
                                    <property name="width-chars">7</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry_c">
                                    <property name="visible">True</property>
                                    <property name="focusable">True</property>
                                    <property name="text">30.0</property>
                                    <property name="width-chars">7</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="label">
                      <object class="GtkCheckButton" id="checkbox_add_solvent_box">
                        <property name="label" translatable="yes">Add Solvent Box</property>
                        <property name="visible">True</property>
                        <property name="focusable">True</property>
                        <property name="active">True</property>
                        <property name="tooltip-text" translatable="yes">Uncheck this if you only want to add counter-ions to the solute, without surrounding it with a solvent box.</property>
                        <signal name="toggled" handler="on_checkbox_add_solvent_box_toggled" swapped="no" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <!-- ==================== Ions ==================== -->
            <child>
              <object class="GtkFrame" id="dftp_setup_box4">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label-xalign">0.5</property>
                <child>
                  <object class="GtkBox" id="frame_add_ions">
                    <property name="visible">True</property>
                    <property name="sensitive">False</property>
                    <property name="focusable">False</property>
                    <property name="margin-top">10</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <child>
                      <object class="GtkBox" id="geo_opt_parm_box4">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">11</property>
                        <child>
                          <object class="GtkGrid">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">10</property>
                            <child>
                              <object class="GtkBox" id="box_cation">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="box_anion">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="hexpand">True</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <placeholder />
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_system7">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Cations:</property>
                                <property name="xalign">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_system8">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Anions:</property>
                                <property name="xalign">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="spinbtn_cations">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="adjustment">adjustment1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="spinbtn_anions">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="adjustment">adjustment2</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="hexpand">False</property>
                                <property name="label" translatable="yes">Ion file</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Quantity</property>
                              </object>
                            </child>
                            <child>
                              <placeholder />
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkCheckButton" id="checkbox_add_ions">
                    <property name="label" translatable="yes">Add Ions</property>
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <property name="tooltip-text" translatable="yes">Cation/anion files are pDynamo systems previously saved with "Pickle" (a single ion each).</property>
                    <signal name="toggled" handler="on_checkbox_add_ions_toggled" swapped="no" />
                  </object>
                </child>
              </object>
            </child>
            <!-- ==================== Status / info ==================== -->
            <child>
              <object class="GtkLabel" id="label_info">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label" translatable="yes">Select a solute system and a solvent box, then click Run.</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label" />
                </style>
              </object>
            </child>
            <!-- ==================== Buttons ==================== -->
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkButton" id="button_cancel">
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Cancel</property>
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <signal name="clicked" handler="on_button_cancel_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button_run">
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Run</property>
                    <property name="width-request">150</property>
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <signal name="clicked" handler="on_button_run_clicked" swapped="no" />
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>