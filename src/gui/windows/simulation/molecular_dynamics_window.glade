<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="setup_md_window">
    <property name="focusable">False</property>
    <property name="resizable">False</property>
    <signal name="close-request" handler="close_window" swapped="no" />
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="focusable">False</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="GtkBox" id="geo_opt_box">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkFrame" id="dftp_setup_box">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label-xalign">0.5</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="margin-top">10</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <child>
                      <object class="GtkBox" id="geo_opt_parm_box">
                        <property name="visible">True</property>
                        <property name="focusable">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">11</property>
                        <child>
                          <!-- n-columns=2 n-rows=13 -->
                          <object class="GtkGrid">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                            <property name="row-spacing">5</property>
                            <property name="column-spacing">5</property>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label4">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Integrator:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label1">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Number of Steps(fs):</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label2">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Temperature:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_number_of_steps">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">1000</property>
                                <property name="input-purpose">number</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="comobobox_md_integrator">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <!-- n-columns=3 n-rows=3 -->
                              <object class="GtkGrid">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="row-spacing">5</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">Start (K)</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="label_temp_end">
                                    <property name="visible">True</property>
                                    <property name="focusable">False</property>
                                    <property name="label" translatable="yes">Stop (K)</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry_temp_start">
                                    <property name="visible">True</property>
                                    <property name="focusable">True</property>
                                    <property name="text" translatable="yes">300</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="entry_temp_end">
                                    <property name="visible">True</property>
                                    <property name="focusable">True</property>
                                    <property name="text" translatable="yes">400</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                                <child>
                                  <placeholder />
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="combobox_temperature_scale_options">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label_temp_scale">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Temp. Scale Frequency:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label66">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Time Step(ps):</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">7</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label45">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Log Frequency:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">8</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label1_MD_window">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Random Seed:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">9</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_collision_freq">
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Collision Frequency:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">10</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_temp_scale_factor">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">100</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">5</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_time_step">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">0.001</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">7</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_log_frequency">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">10</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">8</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_random_seed">
                                <property name="visible">True</property>
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">44561</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">9</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_collision_frequency">
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">25</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">10</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_pressure_coupling">
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Pressure Coupling:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">12</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_pressure">
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">1.0</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">11</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_pressure_coupling">
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">2000.0</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">12</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="check_pressure_control">
                                <property name="label" translatable="yes">Pressure:</property>
                                <property name="focusable">True</property>
                                <property name="halign">end</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">11</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="label_temp_coupling">
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Temp. Coupling::</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">6</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_temp_coupling">
                                <property name="focusable">True</property>
                                <property name="text" translatable="yes">0.1</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">6</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="MMDialog_label3">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="label" translatable="yes">Initial Coordinates:</property>
                                <property name="xalign">1</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="box_coordinates">
                                <property name="visible">True</property>
                                <property name="focusable">False</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <placeholder />
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <placeholder />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                          </object>
                        </child>
                        <child>
                          <placeholder />
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="folder_chooser_box">
                            <property name="visible">True</property>
                            <property name="focusable">False</property>
                            <property name="orientation">vertical</property>
                            <child>
                              <placeholder />
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="label" translatable="yes">Parameters</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="spacing">8</property>
                <property name="halign">end</property>
                <child>
                  <placeholder />
                </child>
                <child>
                  <object class="GtkButton" id="button_cancel">
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Cancel</property>
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <signal name="clicked" handler="close_window" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button_run">
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Run</property>
                    <property name="width-request">150</property>
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <signal name="clicked" handler="run_opt" swapped="no" />
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
