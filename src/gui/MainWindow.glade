                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_molecular_dynamics">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Molecular Dynamics</property>
                    <property name="label" translatable="yes">Molecular Dynamics</property>
                    <property name="use-underline">True</property>
                    <property name="child">image13</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_normal_modes">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Normal Modes</property>
                    <property name="label" translatable="yes">__glade_unnamed_10</property>
                    <property name="use-underline">True</property>
                    <property name="child">image12</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_pes_scan">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Reaction Coordinate Scans</property>
                    <property name="label" translatable="yes">Reaction Coordinate Scans</property>
                    <property name="use-underline">True</property>
                    <property name="child">image5</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_umbrella_sampling">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Umbrella Sampling</property>
                    <property name="label" translatable="yes">Umbrella Sampling</property>
                    <property name="use-underline">True</property>
                    <property name="child">image6</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_chain_of_states_opt">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Nudged Elastic Band (NEB)</property>
                    <property name="label" translatable="yes">Nudged Elastic Band (NEB)</property>
                    <property name="use-underline">True</property>
                    <property name="child">image7</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_export_img">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Export Image</property>
                    <property name="use-underline">True</property>
                    <property name="child">image8</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button_task_list">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Process Monitor</property>
                    <property name="label" translatable="yes">__glade_unnamed_7</property>
                    <property name="use-underline">True</property>
                    <property name="child">image9</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="toolbar5">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <child>
                  <object class="GtkBox" id="toolbutton_selection_box">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="paned_V">
            <property name="visible">True</property>
            <property name="focusable">True</property>
            <property name="valign">baseline</property>
            <property name="orientation">vertical</property>
            <property name="wide-handle">True</property>
            <child>
              <placeholder />
            </child>
            <child>
              <placeholder />
            </child>
          </object>
        </child>
        <child>
          <object class="GtkStatusbar" id="statusbar1">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="margin-start">10</property>
            <property name="margin-end">10</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
