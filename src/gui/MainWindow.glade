  </object>
  <object class="GtkImage" id="image6">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="file">icons/icon_umbrella_sampling_24x24.png</property>
  </object>
  <object class="GtkImage" id="image7">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="file">icons/icon_NEB_24x24.png</property>
  </object>
  <object class="GtkImage" id="image8">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="file">icons/icon_save_image.png</property>
  </object>
  <object class="GtkImage" id="image9">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="file">icons/icon_process_manager.png</property>
  </object>
  <object class="GtkLabel" id="label1">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="label" translatable="yes">label</property>
  </object>
  <object class="GtkLabel" id="label2">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="label" translatable="yes">label</property>
  </object>
  <object class="GtkWindow" id="window1">
    <property name="focusable">False</property>
    <property name="title" translatable="yes">VisMol Main Window</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <child>
      <object class="GtkBox" id="box1">
        <property name="visible">True</property>
        <property name="focusable">False</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="menubar1">
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box2">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <child>
              <object class="GtkBox" id="toolbar1">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <child>
                  <object class="GtkButton" id="toolbutton_new_system">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Import a new system</property>
                    <property name="halign">center</property>
                    <property name="label" translatable="yes">New Project</property>
                    <property name="use-underline">True</property>
                    <property name="child">image1</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_open">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Open EasyHybrid/pDynamo serialization files</property>
                    <property name="label" translatable="yes">Open</property>
                    <property name="use-underline">True</property>
                    <property name="child">image2</property>
                    <signal name="clicked" handler="open_gtk_load_files" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_save">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Save EasyHybrid session</property>
                    <property name="label" translatable="yes">Save</property>
                    <property name="use-underline">True</property>
                    <property name="child">image3</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_save_as">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Save As EasyHybrid session</property>
                    <property name="label" translatable="yes">Save As</property>
                    <property name="use-underline">True</property>
                    <property name="child">image4</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="toolbar2_selections">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <child>
                  <object class="GtkToggleButton" id="toolbutton_terminal">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Show Terminal</property>
                    <property name="label" translatable="yes">Command line</property>
                    <property name="use-underline">True</property>
                    <property name="child">image20</property>
                    <signal name="toggled" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="toolbutton_trajectory_tool1">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Show Trajectory Handler</property>
                    <property name="label" translatable="yes">Trajectory Player</property>
                    <property name="use-underline">True</property>
                    <property name="child">image21</property>
                    <signal name="toggled" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="_show_cell">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Draw Geometry</property>
                    <property name="label" translatable="yes">Cell and Symmetry</property>
                    <property name="use-underline">True</property>
                    <property name="child">image10</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="selections">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes"> Selections and Restraints</property>
                    <property name="label" translatable="yes">Selections and Restraints</property>
                    <property name="use-underline">True</property>
                    <property name="child">image22</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button_go_to_atom">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Go To Atom</property>
                    <property name="label" translatable="yes">Go To Atom</property>
                    <property name="use-underline">True</property>
                    <property name="child">image23</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_pDynamo_selections">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Extend Selection</property>
                    <property name="label" translatable="yes">Extend </property>
                    <property name="use-underline">True</property>
                    <property name="child">image24</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_setup_QCModel">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Quantum Chemistry</property>
                    <property name="label" translatable="yes">Setup QC Region</property>
                    <property name="use-underline">True</property>
                    <property name="child">image25</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="toolbar4_pdynamo_tools">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <child>
                  <object class="GtkButton" id="toolbutton_energy">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Energy / Energy Refinement</property>
                    <property name="label" translatable="yes">Energy</property>
                    <property name="use-underline">True</property>
                    <property name="child">image14</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="toolbutton_geometry_optimization">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="tooltip-text" translatable="yes">Geometry Optimization</property>
                    <property name="label" translatable="yes">Geometry Optmization</property>
                    <property name="use-underline">True</property>
                    <property name="child">image15</property>
                    <signal name="clicked" handler="on_main_toolbar_clicked" swapped="no" />
