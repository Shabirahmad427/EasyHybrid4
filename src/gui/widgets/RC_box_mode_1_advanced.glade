<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkBox" id="reaction_coordinate_box">
    <property name="visible">True</property>
    <property name="focusable">False</property>
    <property name="orientation">vertical</property>
    <property name="spacing">4</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="focusable">False</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkScrolledWindow" id="scrolledbox">
            <property name="height-request">150</property>
            <property name="visible">True</property>
            <property name="focusable">True</property>
            <property name="vexpand">True</property>
            <child>
              <placeholder />
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="mode1_box">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="orientation">vertical</property>
            <child>
              <placeholder />
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="rc_aligment">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="margin-top">5</property>
            <property name="margin-bottom">5</property>
            <property name="margin-start">10</property>
            <property name="margin-end">10</property>
            <child>
              <object class="GtkSeparator">
                <property name="visible">True</property>
                <property name="focusable">False</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <!-- n-columns=2 n-rows=4 -->
          <object class="GtkGrid" id="rc_grid">
            <property name="visible">True</property>
            <property name="focusable">False</property>
            <property name="halign">end</property>
            <property name="row-spacing">5</property>
            <property name="column-spacing">10</property>
            <child>
              <object class="GtkLabel" id="label_force">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label" translatable="yes">Force Constante:</property>
                <property name="xalign">1</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_initial_distance_angle_dihedral">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label" translatable="yes">Initial Distance:</property>
                <property name="xalign">1</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="entry_FORCE_coord1">
                <property name="visible">True</property>
                <property name="focusable">True</property>
                <property name="text" translatable="yes">4000</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="entry_dmin_coord1">
                <property name="visible">True</property>
                <property name="focusable">True</property>
                <property name="text" translatable="yes">0</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_num_of_steps">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label" translatable="yes">Number of Steps:</property>
                <property name="xalign">1</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_step_size">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="label" translatable="yes">Step Size:</property>
                <property name="xalign">1</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="entry_step_size1">
                <property name="visible">True</property>
                <property name="focusable">True</property>
                <property name="text" translatable="yes">0.1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <!-- n-columns=2 n-rows=2 -->
              <object class="GtkGrid">
                <property name="visible">True</property>
                <property name="focusable">False</property>
                <property name="row-spacing">5</property>
                <property name="column-spacing">4</property>
                <child>
                  <object class="GtkLabel" id="label_f">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="label" translatable="yes">F &gt;</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label_b">
                    <property name="visible">True</property>
                    <property name="focusable">False</property>
                    <property name="label" translatable="yes">B &lt;</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="entry_nsteps1">
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <property name="hexpand">False</property>
                    <property name="vexpand">False</property>
                    <property name="text" translatable="yes">30</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="entry_nsteps2">
                    <property name="visible">True</property>
                    <property name="focusable">True</property>
                    <property name="hexpand">False</property>
                    <property name="vexpand">False</property>
                    <property name="text" translatable="yes">0</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="mode0_box">
        <property name="visible">True</property>
        <property name="focusable">False</property>
        <property name="orientation">vertical</property>
        <child>
          <placeholder />
        </child>
      </object>
    </child>
  </object>
</interface>