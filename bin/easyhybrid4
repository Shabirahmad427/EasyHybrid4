#!/usr/bin/env bash
set -e

# Follow symlinks so this entry point works from ~/.local/bin as well as
# when called directly from the EasyHybrid4 checkout.
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_dir="$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd)"
    target="$(readlink "$script_path")"
    if [[ "$target" = /* ]]; then
        script_path="$target"
    else
        script_path="$script_dir/$target"
    fi
done
script_dir="$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd)"
exec "$script_dir/../activate_easyhybrid4.sh" "$@"
